# Only needed to test locally (npm run hide / npm run show).
# On GitHub these come from the repo's Actions secrets and variables.
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here

# "all" hides every channel in the server, or list category IDs (commas, spaces or new lines)
CATEGORY_IDS=all
# optional: comma-separated category or channel IDs to leave visible at night (e.g. announcements)
EXCLUDE_CATEGORY_IDS=
